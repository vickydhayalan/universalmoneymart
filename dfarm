            </div>
            <p class="text-[11px] text-slate-500 font-medium tracking-wide" data-i18n="brand_tagline">Dhayalan & Sons • Polur</p>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center space-x-6 text-sm font-semibold text-slate-600">
          <a href="#about-story" class="hover:text-forest-600 transition flex items-center gap-1.5">
            <i class="fa-solid fa-heart text-red-500"></i> <span data-i18n="nav_story">Namma Kathai</span>
          </a>
          <a href="#bio-cycle" class="hover:text-forest-600 transition flex items-center gap-1.5">
            <i class="fa-solid fa-arrows-rotate text-forest-500"></i> <span data-i18n="nav_biocycle">Circular Bio-Cycle</span>
          </a>
          <a href="#products-catalog" class="hover:text-forest-600 transition flex items-center gap-1.5">
