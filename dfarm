      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            forest: {
              50: '#f0fdf4',
              100: '#dcfce7',
              200: '#bbf7d0',
              300: '#86efac',
              400: '#4ade80',
              500: '#22c55e',
