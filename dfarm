          <button id="langBtnEn" onclick="switchLanguage('en')" class="px-2 py-0.5 rounded text-[11px] font-bold transition-all text-white bg-forest-600 shadow-sm">EN</button>
          <button id="langBtnTa" onclick="switchLanguage('ta')" class="px-2 py-0.5 rounded text-[11px] font-bold transition-all text-forest-300 hover:text-white">தமிழ்</button>
        </div>
        <span class="text-forest-700">|</span>
        <a href="tel:+918870804123" class="hover:text-amber-400 transition flex items-center gap-1.5">
          <i class="fa-solid fa-phone text-forest-400"></i> <span>Appa: 8870804123</span>
        </a>
        <span class="text-forest-700">|</span>
        <button onclick="toggleOwnerPortal()" class="text-amber-400 hover:text-amber-300 font-semibold flex items-center gap-1">
          <i class="fa-solid fa-lock text-[10px]"></i> <span data-i18n="ticker_owner">Owner Portal</span>
        </button>
      </div>
    </div>
  </aside>

  <!-- NAVIGATION HEADER -->
