    // 3. CART SYSTEM (ITEMS, QUANTITY, LOCALSTORAGE & WHATSAPP GENERATION)
    let cart = JSON.parse(localStorage.getItem('dfarm_cart')) || [];

    function saveCart() {
      localStorage.setItem('dfarm_cart', JSON.stringify(cart));
      updateCartUI();
    }

    function addToCart(productId) {
      const item = farmInventory.find(i => i.id === productId);
      if (!item) return;

      const existing = cart.find(c => c.id === productId);
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({
          id: item.id,
          name_en: item.name_en,
          name_ta: item.name_ta,
          price: item.priceNumber,
          unit_en: item.unit_en,
          unit_ta: item.unit_ta,
          img: item.img,
          qty: 1
        });
      }
      saveCart();
      showAddedToast(item);
    }

    function updateCartQty(productId, delta) {
      const entry = cart.find(c => c.id === productId);
      if (!entry) return;

      entry.qty += delta;
      if (entry.qty <= 0) {
        cart = cart.filter(c => c.id !== productId);
      }
      saveCart();
    }

    function removeCartItem(productId) {
      cart = cart.filter(c => c.id !== productId);
      saveCart();
    }

    function toggleCartDrawer() {
      const drawer = document.getElementById('cartDrawer');
      if (drawer) {
        drawer.classList.toggle('hidden');
      }
    }

    function updateCartUI() {
      const totalCount = cart.reduce((acc, curr) => acc + curr.qty, 0);
      const totalPrice = cart.reduce((acc, curr) => acc + (curr.qty * curr.price), 0);

      const badgeCount = document.getElementById('cartBadgeCount');
      const mobileBadge = document.getElementById('mobileCartBadgeCount');
      const floatCount = document.getElementById('floatCartItemCount');
      const totalElem = document.getElementById('cartTotalPrice');

      if (badgeCount) badgeCount.innerText = totalCount;
      if (mobileBadge) mobileBadge.innerText = totalCount;
      if (floatCount) floatCount.innerText = totalCount;
      if (totalElem) totalElem.innerText = `₹${totalPrice.toLocaleString('en-IN')}`;

      // Render cart item list in drawer
      const container = document.getElementById('cartItemsContainer');
      if (!container) return;

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 text-slate-400">
            <i class="fa-solid fa-basket-shopping text-4xl mb-3 text-slate-300"></i>
            <p class="text-sm font-semibold">${translations[currentLang].cart_empty}</p>
          </div>
        `;
        return;
      }

      container.innerHTML = cart.map(item => {
        const title = currentLang === 'ta' ? item.name_ta : item.name_en;
        const unit = currentLang === 'ta' ? item.unit_ta : item.unit_en;
        const lineTotal = item.qty * item.price;

        return `
          <div class="flex items-center space-x-3 p-3 rounded-2xl bg-stone-50 border border-slate-200">
            <img src="${item.img}" alt="${title}" class="w-16 h-16 rounded-xl object-cover border border-slate-200 shrink-0">
            <div class="flex-1 min-w-0">
              <h4 class="font-bold text-xs text-slate-900 truncate">${title}</h4>
              <p class="text-[11px] text-slate-500 font-semibold">₹${item.price.toLocaleString('en-IN')} / ${unit}</p>
              <div class="flex items-center space-x-2 mt-2">
                <button onclick="updateCartQty('${item.id}', -1)" class="w-6 h-6 rounded-lg bg-white border border-slate-300 text-slate-700 font-bold flex items-center justify-center hover:bg-slate-100 text-xs">-</button>
                <span class="text-xs font-bold text-slate-900 px-1">${item.qty}</span>
                <button onclick="updateCartQty('${item.id}', 1)" class="w-6 h-6 rounded-lg bg-white border border-slate-300 text-slate-700 font-bold flex items-center justify-center hover:bg-slate-100 text-xs">+</button>
              </div>
            </div>
            <div class="text-right">
              <p class="font-bold text-xs text-slate-900">₹${lineTotal.toLocaleString('en-IN')}</p>
              <button onclick="removeCartItem('${item.id}')" class="text-[10px] text-red-500 hover:text-red-700 mt-2 font-bold">Remove</button>
            </div>
          </div>
        `;
      }).join('');
    }

    function showAddedToast(item) {
      const name = currentLang === 'ta' ? item.name_ta : item.name_en;
      const toast = document.createElement('div');
      toast.className = "fixed bottom-24 right-6 z-50 bg-forest-900 text-white text-xs font-bold py-2.5 px-4 rounded-2xl shadow-2xl border border-forest-700 flex items-center space-x-2 animate-bounce";
      toast.innerHTML = `<i class="fa-solid fa-check text-amber-400"></i> <span>Added ${name} to Cart!</span>`;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.remove();
