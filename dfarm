        <div class="inline-flex items-center bg-stone-100 border border-slate-300 rounded-xl p-1">
          <button onclick="switchLanguage('en')" id="mobLangEn" class="px-3 py-1 rounded-lg text-xs font-bold bg-forest-700 text-white shadow-sm">English</button>
          <button onclick="switchLanguage('ta')" id="mobLangTa" class="px-3 py-1 rounded-lg text-xs font-bold text-slate-600">தமிழ்</button>
        </div>
      </div>
      <a href="#about-story" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-semibold hover:text-forest-600"><i class="fa-solid fa-heart mr-2 text-red-500"></i> <span data-i18n="nav_story">Namma Kathai (Appa Amma Story)</span></a>
      <a href="#bio-cycle" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-semibold hover:text-forest-600"><i class="fa-solid fa-arrows-rotate mr-2 text-forest-500"></i> <span data-i18n="nav_biocycle">Circular Bio-Cycle</span></a>
      <a href="#products-catalog" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-semibold hover:text-forest-600"><i class="fa-solid fa-store mr-2 text-forest-500"></i> <span data-i18n="nav_store">Farm Store & Livestock</span></a>
      <a href="#packaged-goods" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-semibold hover:text-forest-600"><i class="fa-solid fa-box mr-2 text-forest-500"></i> <span data-i18n="nav_packaged">E-Commerce Packed Items</span></a>
      <a href="#qr-share" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-semibold hover:text-forest-600"><i class="fa-solid fa-qrcode mr-2 text-forest-500"></i> <span data-i18n="nav_qr">Farm QR Code & Socials</span></a>
      <a href="#about-contact" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-semibold hover:text-forest-600"><i class="fa-solid fa-map-pin mr-2 text-forest-500"></i> <span data-i18n="nav_contact">Location & Contact</span></a>
      <div class="pt-2 border-t border-slate-100 flex gap-2">
