      <div class="flex items-center space-x-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-forest-700 text-forest-100 uppercase tracking-wider animate-pulse">
          <i class="fa-solid fa-circle text-[6px] mr-1.5 text-emerald-300"></i><span data-i18n="ticker_badge">Live Farm</span>
        </span>
        <span class="font-medium text-slate-300 truncate" data-i18n="ticker_text">100% Organic • Solar & Biogas Driven • 3.2 Acre Eco Circular Habitat • Polur, TN</span>
      </div>
      <div class="flex items-center space-x-3 text-xs">
        <!-- Language Switcher in Top Bar -->
