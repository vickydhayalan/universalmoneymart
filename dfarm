                <p class="font-display font-extrabold text-2xl text-amber-600">100%</p>
                <p class="text-xs text-slate-500 font-medium" data-i18n="stat_solar">Solar & Bio-Power</p>
              </div>
              <div class="p-3 rounded-2xl bg-white/70 border border-slate-200/60 shadow-sm">
                <p class="font-display font-extrabold text-2xl text-forest-800">Zero</p>
                <p class="text-xs text-slate-500 font-medium" data-i18n="stat_waste">Manual Strain</p>
