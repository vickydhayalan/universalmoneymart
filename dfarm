    // 5. RENDER BIO-CYCLE NODES
    function renderBioNodes() {
      const container = document.getElementById('bioCycleNodes');
      if (!container) return;
      container.innerHTML = '';

      const steps = bioCycleData[currentLang];
      steps.forEach((node, index) => {
        const isSelected = index === activeBioIndex;
        const card = document.createElement('div');
        card.onclick = () => selectBioNode(index);
        card.className = `bio-node-card cursor-pointer p-4 rounded-2xl bg-white transition-all hover:-translate-y-1 ${
          isSelected ? 'border-2 border-forest-500 shadow-md' : 'border border-slate-200 shadow-sm'
        }`;
        card.setAttribute('data-index', index);

        card.innerHTML = `
          <div class="w-10 h-10 rounded-xl ${node.colorClass} text-white flex items-center justify-center mb-3 text-lg shadow-sm">
            <i class="fa-solid ${node.icon}"></i>
          </div>
          <span class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">${node.step}</span>
          <h4 class="font-bold text-slate-900 text-sm mt-0.5">${node.shortTitle}</h4>
          <p class="text-xs text-slate-500 mt-1 line-clamp-2">${node.shortDesc}</p>
        `;
        container.appendChild(card);
      });

      selectBioNode(activeBioIndex);
    }

    function selectBioNode(index) {
      activeBioIndex = index;
      const data = bioCycleData[currentLang][index];
      const cards = document.querySelectorAll('.bio-node-card');
      cards.forEach((card, idx) => {
        if (idx === index) {
          card.classList.add('border-forest-500', 'border-2', 'shadow-md');
          card.classList.remove('border-slate-200');
        } else {
          card.classList.remove('border-forest-500', 'border-2', 'shadow-md');
          card.classList.add('border-slate-200');
        }
      });

      const iconElem = document.getElementById('bioDetailIcon');
      const tagElem = document.getElementById('bioDetailTag');
      const titleElem = document.getElementById('bioDetailTitle');
      const descElem = document.getElementById('bioDetailDesc');

      if (iconElem && tagElem && titleElem && descElem) {
        iconElem.className = `w-14 h-14 rounded-2xl ${data.colorClass} text-white flex items-center justify-center text-2xl shrink-0 shadow-md`;
        iconElem.innerHTML = `<i class="fa-solid ${data.icon}"></i>`;
        tagElem.innerText = data.tag;
        titleElem.innerText = data.title;
        descElem.innerText = data.desc;
      }
    }

