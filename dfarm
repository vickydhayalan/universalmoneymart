  <!-- SLIDE-OVER SHOPPING CART DRAWER (ITEMIZED WHATSAPP CHECKOUT) -->
  <div id="cartDrawer" class="fixed inset-0 z-50 overflow-hidden hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="toggleCartDrawer()"></div>
    <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
      <div class="pointer-events-auto w-screen max-w-md bg-white shadow-2xl flex flex-col justify-between">
        
        <!-- Cart Top Header -->
        <div class="p-6 border-b border-slate-200 bg-forest-900 text-white">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
              <div class="w-9 h-9 rounded-xl bg-amber-400 text-forest-950 flex items-center justify-center font-bold">
                <i class="fa-solid fa-basket-shopping"></i>
              </div>
              <div>
                <h3 class="font-display font-bold text-lg" data-i18n="cart_title">Your Farm Basket</h3>
                <p class="text-xs text-forest-200" data-i18n="cart_subtitle">Direct dispatch to WhatsApp (Vignesh)</p>
              </div>
            </div>
            <button onclick="toggleCartDrawer()" class="p-2 text-forest-300 hover:text-white rounded-lg">
              <i class="fa-solid fa-xmark text-lg"></i>
            </button>
          </div>
        </div>

