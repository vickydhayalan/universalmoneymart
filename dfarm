      items.forEach(item => {
        const name = currentLang === 'ta' ? item.name_ta : item.name_en;
        const tag = currentLang === 'ta' ? item.tag_ta : item.tag_en;
        const desc = currentLang === 'ta' ? item.desc_ta : item.desc_en;
        const unit = currentLang === 'ta' ? item.unit_ta : item.unit_en;
        const stock = currentLang === 'ta' ? item.stock_ta : item.stock_en;
        const btnAdd = translations[currentLang].btn_add_to_cart;
        const btnWa = translations[currentLang].btn_buy_wa;

        const card = document.createElement('div');
        card.className = "bg-white rounded-3xl p-4 border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group";

        card.innerHTML = `
          <div>
            <!-- Product Image -->
            <div class="relative rounded-2xl overflow-hidden bg-stone-100 h-44 mb-3 border border-slate-100">
              <img src="${item.img}" alt="${name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              
              <span class="absolute top-2.5 left-2.5 text-[10px] font-bold uppercase tracking-wider text-forest-950 bg-amber-400 px-2.5 py-0.5 rounded-full shadow-md">
                ${stock}
              </span>
              <span class="absolute bottom-2.5 left-2.5 text-white text-[11px] font-bold drop-shadow">
                ${tag}
              </span>
            </div>

            <h3 class="font-display font-bold text-slate-900 text-sm sm:text-base leading-snug line-clamp-2">${name}</h3>
            <p class="text-xs text-slate-500 mt-1.5 leading-relaxed line-clamp-2">${desc}</p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100">
            <div class="flex items-baseline justify-between mb-3">
              <div>
                <span class="font-display font-extrabold text-base sm:text-lg text-slate-900">${item.priceDisplay}</span>
                <span class="text-[11px] text-slate-400 block">${unit}</span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <button onclick="addToCart('${item.id}')" class="py-2.5 px-2 rounded-xl font-bold text-xs bg-forest-100 hover:bg-forest-200 text-forest-950 transition flex items-center justify-center gap-1 active:scale-95 shadow-sm">
                <i class="fa-solid fa-cart-plus text-forest-700"></i>
                <span>${btnAdd}</span>
              </button>
              <button onclick="quickOrderWhatsApp('${encodeURIComponent(name)}', '')" class="py-2.5 px-2 rounded-xl font-bold text-xs bg-forest-700 hover:bg-forest-800 text-white transition flex items-center justify-center gap-1 active:scale-95 shadow-sm">
                <i class="fa-brands fa-whatsapp text-emerald-400"></i>
                <span>${btnWa}</span>
              </button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function filterCatalog(category) {
      activeCatalogCategory = category;
      renderCatalogFilterButtons();

      if (category === 'All') {
        renderCatalog(farmInventory);
      } else {
        const filtered = farmInventory.filter(item => item.category === category);
        renderCatalog(filtered);
      }
    }

    // 8. ORDER PACKAGED ITEMS (DIRECT TO VIGNESH WHATSAPP)
    function orderPackagedItem(packId) {
      let itemName = "";
      if (packId === 'pack1') {
        itemName = currentLang === 'ta' ? "காய்ந்த சாண வறட்டி 24 பெட்டி (₹249)" : "Desi Cow Dung Cakes Box of 24 (₹249)";
      } else if (packId === 'pack2') {
        itemName = currentLang === 'ta' ? "ஆட்டுப் புழுக்கை உரம் 10 கிலோ பை (₹320)" : "Crushed Goat Manure 10kg Sack (₹320)";
      } else if (packId === 'pack3') {
        itemName = currentLang === 'ta' ? "சூப்பர் நேப்பியர் தீவனக் குச்சிகள் 150 கணுக்கள் (₹499)" : "Super Napier Fodder Stems 150 Cuttings (₹499)";
      }
      quickOrderWhatsApp(itemName, "");
    }

    // 9. WHATSAPP FAST ORDER LINK GENERATOR (DIRECT TO VIGNESH: 7200752628)
    function quickOrderWhatsApp(itemTitle, customMsg) {
      const phone = "917200752628"; // Vignesh Dhayalan's WhatsApp
      const decodedTitle = decodeURIComponent(itemTitle);
      let defaultMsg = "";

      if (currentLang === 'ta') {
        defaultMsg = `வணக்கம் விக்னேஷ் தயாளன் (D-FARM)! நான் பண்ணையிலிருந்து இதைப் பற்றி விசாரிக்க விரும்புகிறேன்: ${decodedTitle}. தற்போதைய இருப்பு மற்றும் கூரியர் விவரங்களை பகிருங்கள்.`;
      } else {
        defaultMsg = `Hello Vignesh Dhayalan (D-FARM)! I would like to inquire about: ${decodedTitle}. Please share current availability and delivery details.`;
      }

      const message = encodeURIComponent(customMsg || defaultMsg);
      window.open(`https://wa.me/${phone}?text=${message}`, '_blank');
    }

    // 10. SHARE & QR CODE INITIALIZATION
    let qrInstance = null;
    function initQRCode() {
      const qrContainer = document.getElementById('qrcode');
      if (!qrContainer) return;
      qrContainer.innerHTML = '';
      
      const currentURL = window.location.href || "https://universalmoneymart.onrender.com";
      qrInstance = new QRCode(qrContainer, {
        text: currentURL,
        width: 170,
        height: 170,
        colorDark: "#052e16",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.H
      });
    }

    function downloadQRCode() {
      const qrCanvas = document.querySelector('#qrcode canvas');
      if (qrCanvas) {
        const imageURI = qrCanvas.toDataURL("image/png");
        const downloadLink = document.createElement('a');
        downloadLink.href = imageURI;
        downloadLink.download = "D-FARM-Vignesh-Dhayalan-QR.png";
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
      } else {
        const qrImg = document.querySelector('#qrcode img');
        if (qrImg) {
          const downloadLink = document.createElement('a');
          downloadLink.href = qrImg.src;
          downloadLink.download = "D-FARM-Vignesh-Dhayalan-QR.png";
          document.body.appendChild(downloadLink);
          downloadLink.click();
          document.body.removeChild(downloadLink);
        }
      }
    }

    function shareOnWhatsApp() {
      const currentURL = window.location.href;
      const text = currentLang === 'ta'
        ? encodeURIComponent(`டி-பார்ம் (D-FARM): தூய A2 நாட்டு மாட்டுப் பால், கிடாரிக் கன்றுகள், ஆடுகள், நாட்டுக் கோழி மற்றும் இயற்கை சாண வறட்டிகள்: ${currentURL}`)
        : encodeURIComponent(`Check out D-FARM by Vignesh Dhayalan: Sustainable A2 Dairy, Native Poultry, Organic Pooja Saani, and Green Fodder: ${currentURL}`);
      window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    // 11. OWNER OPERATIONS PORTAL (PIN: 2026)
    function toggleOwnerPortal() {
      const portal = document.getElementById('owner-portal');
      if (portal) {
        portal.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function verifyOwnerPin() {
      const pin = document.getElementById('managerPinInput').value.trim();
      const errorMsg = document.getElementById('pinErrorMsg');
      const lockScreen = document.getElementById('portalLockScreen');
      const dashboard = document.getElementById('portalDashboard');

      if (pin === '2026' || pin.toLowerCase() === 'dfarm') {
        errorMsg.classList.add('hidden');
        lockScreen.classList.add('hidden');
        dashboard.classList.remove('hidden');
      } else {
        errorMsg.classList.remove('hidden');
      }
    }

    function handleQuickLog(e) {
      e.preventDefault();
      const milk = document.getElementById('logMilkInput').value;
      const msg = document.getElementById('logSuccessMsg');
      const kpiMilk = document.getElementById('kpiMilkYield');
      const unit = translations[currentLang].unit_litres;

      if (milk && kpiMilk) {
        kpiMilk.innerHTML = `${milk} <span class="text-sm font-normal text-slate-400">${unit}</span>`;
      }

      msg.classList.remove('hidden');
      setTimeout(() => {
        msg.classList.add('hidden');
      }, 3500);
      e.target.reset();
    }

    // 12. NAVIGATION HELPERS
    function toggleMobileMenu() {
      const menu = document.getElementById('mobileMenu');
      if (menu) menu.classList.toggle('hidden');
    }

    function scrollToCatalog() {
      const elem = document.getElementById('products-catalog');
      if (elem) elem.scrollIntoView({ behavior: 'smooth' });
    }

    function scrollToQR() {
      const elem = document.getElementById('qr-share');
      if (elem) elem.scrollIntoView({ behavior: 'smooth' });
    }

    // 13. INITIALIZATION
    window.addEventListener('DOMContentLoaded', () => {
      switchLanguage(currentLang);
      initQRCode();
      updateCartUI();
    });
  </script>
</body>
</html>
