            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider" data-i18n="cart_field_location">Delivery Town / ஊர் / மாவட்டம் *</label>
              <input type="text" id="customerLocationInput" placeholder="e.g. Polur / Chennai / Vellore" class="w-full py-2 px-3 rounded-xl bg-white border border-slate-300 text-sm focus:outline-none focus:border-forest-600">
            </div>
          </div>

          <!-- Total Calculation -->
          <div class="pt-2 flex items-baseline justify-between border-t border-slate-200">
            <span class="font-bold text-slate-700 text-sm" data-i18n="cart_total_label">Estimated Total:</span>
            <span class="font-display font-black text-2xl text-forest-950" id="cartTotalPrice">₹0</span>
          </div>

          <!-- Send Order Button -->
          <button onclick="submitCartWhatsApp()" class="w-full py-3.5 px-4 rounded-xl font-bold text-white bg-forest-700 hover:bg-forest-800 transition active:scale-95 flex items-center justify-center gap-2.5 shadow-lg shadow-forest-800/25">
            <i class="fa-brands fa-whatsapp text-xl text-emerald-400"></i>
