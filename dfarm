          </button>

          <!-- Vignesh WhatsApp Direct Button -->
          <button onclick="quickOrderWhatsApp('General Farm Inquiry', '')" class="inline-flex items-center px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-forest-600 hover:bg-forest-700 shadow-md shadow-forest-600/20 transition active:scale-95 gap-2">
            <i class="fa-brands fa-whatsapp text-lg"></i>
            <span data-i18n="btn_whatsapp">WhatsApp (Vignesh)</span>
