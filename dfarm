          <a href="#packaged-goods" class="hover:text-forest-600 transition flex items-center gap-1.5">
            <i class="fa-solid fa-box text-forest-500"></i> <span data-i18n="nav_packaged">E-Commerce Ready</span>
          </a>
          <a href="#qr-share" class="hover:text-forest-600 transition flex items-center gap-1.5">
            <i class="fa-solid fa-qrcode text-forest-500"></i> <span data-i18n="nav_qr">Share & QR</span>
          </a>
          <a href="#about-contact" class="hover:text-forest-600 transition" data-i18n="nav_contact">Contact</a>
        </nav>

        <!-- Header Actions -->
        <div class="hidden sm:flex items-center space-x-3">
          <!-- Desktop Language Pill -->
          <div class="inline-flex items-center bg-stone-100 border border-slate-300 rounded-xl p-1 shadow-sm">
            <button onclick="switchLanguage('en')" id="deskLangEn" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-white text-forest-900 shadow-sm transition">EN</button>
            <button onclick="switchLanguage('ta')" id="deskLangTa" class="px-2.5 py-1 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition">தமிழ்</button>
